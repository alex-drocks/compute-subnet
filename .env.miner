WANDB_API_KEY="your_api_key"

# Miner identity (CLI args take precedence: --wallet.name, --wallet.hotkey)
MINER_WALLET_NAME=
MINER_HOTKEY_NAME=

# Miner networking (CLI args take precedence: --axon.external_ip, --axon.port, --ssh.port)
MINER_AXON_HOST=
MINER_AXON_PORT=
MINER_SSH_PORT=4444
MINER_TEST_SSH_PORT=4445

# RPC endpoints (CLI args take precedence: --subtensor.chain_endpoint, --subtensor.network)
MINER_RPC_WSS=wss://entrypoint-finney.opentensor.ai:443
MINER_RPC_HTTP=

# Miner logging
MINER_LOG_LEVEL=DEBUG
MINER_LOG_JSON=0

# Attestation Layer auth token (URL configured in config.yaml attestation_layer section)
ATTESTATION_LAYER_AUTH_TOKEN=
